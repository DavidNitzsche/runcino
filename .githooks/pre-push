#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# IF THIS HOOK JUST FAILED YOU AND YOU BELIEVE IT'S UNRELATED WIP — READ THIS
# ─────────────────────────────────────────────────────────────────────────────
#
# This is a SHARED checkout. Multiple agents routinely hold uncommitted work
# in it at the same time, so this hook (which typechecks/builds the CURRENT
# WORKING TREE) can fail on code you did not write and your push does not
# touch. `git push --no-verify` is not the first move.
#
# Formal policy (locked 2026-09-01, `docs/PRODUCT_DECISIONS.md` §"2026-09-01
# · Four calls on the migration handback's open questions" #4):
#
#   1. Run `scripts/verify-commit.sh <your-sha>` — it checks out your EXACT
#      commit into an isolated worktree and runs the same checks this hook
#      runs, against that clean copy, not the dirty shared tree.
#   2. If it passes clean, you have proven the failure above is unrelated
#      to your commit. That is conditions (2) and (3) of the policy, done.
#   3. You still owe conditions (1) "prove unrelatedness" (verify-commit's
#      pass IS that proof once you've confirmed the diff), (4) "record the
#      result" (handback or commit metadata), (5) "confirm CI/deployment
#      succeeds", (6) "no merge/migration/security/destructive check
#      skipped", and (7) "disclose the bypass, don't push silently."
#   4. THEN `git push --no-verify`, and say so — in the handback, in the
#      commit message, wherever the next reader will actually see it.
#
# If you can't prove unrelatedness, can't reproduce this hook's checks in
# isolation, isolated verification DISAGREES with this hook, this hook checks
# something unavailable elsewhere, or your push touches shared state other
# agents may depend on (schema, shared config, cross-agent contracts) — STOP
# and ask. Don't bypass on your own judgment in those cases.
#
# Full policy, worked examples, and the incidents that motivated it:
# `docs/VERIFICATION_POLICY.md`.
# ─────────────────────────────────────────────────────────────────────────────
#
# pre-push · the repo's only automated gate that runs on a Mac.
#
# Before this file existed, .git/hooks/pre-push was a bare symlink to
# scripts/check-web-build.sh. That works, but a symlink can hold exactly one
# check and is invisible to git — nobody cloning this repo gets it, and nobody
# reviewing a diff can see it change. So the hook became a real, versioned
# dispatcher and the symlink's job moved inside it, unchanged.
#
# To activate (once per clone):
#     git config core.hooksPath .githooks
#
# To check it is active:
#     git config --get core.hooksPath      # → .githooks
#
# To deactivate:
#     git config --unset core.hooksPath    # falls back to .git/hooks
#
# To skip in an emergency (say so in the push message):
#     git push --no-verify
#
# WHAT RUNS, AND WHY HERE
#
#   main-push-guard      · only when the push targets refs/heads/main (any
#                          remote — see Section 0 below). Machine-wide mkdir
#                          lock serializes concurrent integrations, and the
#                          push is refused outright unless a matching,
#                          unexpired, single-use authorization record already
#                          exists for the exact commit being pushed. Added
#                          2026-09-11 after an agent self-merged and pushed to
#                          production while its own review was still in
#                          progress — nothing before this made that
#                          structurally hard. `scripts/main-push-lock.sh` is
#                          the CLI; `scripts/lib/main-push-guard.sh` has the
#                          full design writeup (what this can and cannot
#                          protect against — read it before assuming more
#                          coverage than it claims).
#
#   check-web-build.sh   · only when the push touches web-v2 (mirrors
#                          touches_watch below — see touches_web). Typechecks
#                          web-v2 so a missing import is caught here rather
#                          than by the sixteenth failed Railway deploy in a
#                          row — and since 2026-08-30 also runs `next build`
#                          (~30s), because tsc passing is not evidence that
#                          Railway will deploy. On 2026-08-30 `main` sat
#                          undeployed for a full day with tsc and twelve
#                          prebuild gates all green; the break was in the
#                          build, which nothing here was running. Scoped
#                          2026-09-11: this used to run unconditionally, so a
#                          push touching only e.g. `docs/` from a worktree
#                          with no `web-v2/node_modules` got hard-blocked by
#                          the missing-node_modules refusal below for a
#                          change that never touched web-v2 at all — real,
#                          frequent friction across this repo's many
#                          concurrent worktrees. Scoping to `touches_web`
#                          keeps the 2026-09-11 refusal-not-silent-skip fix
#                          (see check-web-build.sh's own header) intact for
#                          every push that actually needs it, without paying
#                          it on every push regardless of content.
#
#   check-watch.sh       · only when the push touches watch code. Runs the
#                          watch engine suite and audits rendered board
#                          geometry. It cannot live in web-v2's prebuild
#                          beside check-palette-sync.sh and check-doctrine.sh,
#                          because Railway's build container has no Xcode: it
#                          would either break every deploy or skip itself on
#                          every deploy. A pre-push hook is the only automated
#                          thing in this repo that is guaranteed to be on a Mac
#                          with a simulator.
#
# Set FAFF_WATCH_FAST=1 to skip the board rendering half (tests only).
#
# NOTE ON --no-verify: it now also skips the main-push lock and authorization
# gate below, same as it already skips everything else here. The disclosure
# obligation at the top of this file ("say so — in the handback, in the
# commit message") applies with extra weight to a bypassed push to main —
# say WHO authorized it and where, since the structural check that would
# normally carry that record did not run.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

# ── which paths is this push actually carrying? ──────────────────────────────
# git feeds a pre-push hook one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# When the range cannot be resolved — a brand-new branch the remote has never
# seen, or the hook invoked by hand with no stdin — we do NOT guess. We assume
# everything changed and run every check. A gate that opts itself out on the
# ambiguous case is a gate that opts itself out.
changed=""
scoped=1
MAIN_PUSH_SHAS=""
while read -r _lref lsha rref rsha; do
  [ -z "${lsha:-}" ] && continue
  # Captured alongside the existing loop rather than in a second stdin read —
  # stdin is a pipe and can only be consumed once. Guarded on the REMOTE ref
  # (what the push updates), not the local branch name, so `git push origin
  # some-local-name:main` is caught the same as pushing an actual local `main`.
  #
  # THIS CHECK RUNS BEFORE THE DELETION SHORT-CIRCUIT BELOW, DELIBERATELY.
  # Until this fix, `[ "$lsha" = "$ZERO" ] && continue` (a branch deletion)
  # ran FIRST, so `git push origin :main` never reached this `if` at all —
  # MAIN_PUSH_SHAS stayed empty, Section 0 below never ran, and a deletion of
  # main sailed through with no lock and no authorization check whatsoever
  # (reproduced live: `git push origin :main` with zero authorization on file
  # went straight through, stopped only by the remote's own unrelated
  # `receive.denyDeleteCurrent`, which is not guaranteed to be set the same
  # way everywhere). Deleting main is at least as destructive as an
  # unauthorized content push, so it must clear the exact same gate. When
  # `lsha` is `$ZERO` here, `MAIN_PUSH_SHAS` is populated with `$ZERO` itself —
  # `mpg_check_authorization`/`mpg_authorize` both resolve a SHA through
  # `mpg_canonical_sha` (`git rev-parse --verify <sha>^{commit}`), and the
  # all-zero SHA never resolves to a real commit, so a deletion of main can
  # never be authorized through the normal flow — it fails closed
  # unconditionally, same as any other push nobody has signed off on. The
  # only way past that is the documented `git push --no-verify` escape hatch,
  # which already carries its own disclosure obligation.
  if [ "${rref:-}" = "refs/heads/main" ]; then
    MAIN_PUSH_SHAS="$MAIN_PUSH_SHAS$lsha"$'\n'
  fi
  [ "$lsha" = "$ZERO" ] && continue            # branch deletion — nothing else to diff
  if [ "${rsha:-$ZERO}" != "$ZERO" ] && git cat-file -e "$rsha" 2>/dev/null; then
    changed="$changed$(git diff --name-only "$rsha" "$lsha")"$'\n'
  else
    scoped=0
  fi
done

if [ "$scoped" = "1" ] && [ -z "$changed" ]; then
  scoped=0   # no stdin at all (manual invocation)
fi

touches_watch() {
  [ "$scoped" = "0" ] && return 0
  printf '%s' "$changed" | grep -qE \
    '^(legacy/native/Faff/FaffWatch|native-v2/project\.yml|native-v2/Faff\.xcodeproj/|scripts/watch/|scripts/check-watch\.sh)'
}

# Same shape as touches_watch above: fail OPEN (run the check) whenever the
# touched-paths range can't be resolved (scoped=0 — a brand-new branch, or a
# manual invocation with no stdin), never guess narrow. Includes the gate
# script itself and its falsifier, same convention as touches_watch including
# scripts/check-watch.sh, so editing the gate forces the gate to run.
touches_web() {
  [ "$scoped" = "0" ] && return 0
  printf '%s' "$changed" | grep -qE \
    '^(web-v2/|scripts/check-web-build\.sh|scripts/check-web-build-node-modules-gate\.sh)'
}

# ── 0 · main-push lock + authorization ───────────────────────────────────────
# Feature-branch pushes never reach this block (MAIN_PUSH_SHAS stays empty) —
# they are exactly as unrestricted as before this change. Runs BEFORE the
# (slower) build/watch checks below so an unauthorized attempt fails fast
# rather than burning a typecheck+build first.
if [ -n "$MAIN_PUSH_SHAS" ] && [ -f "$ROOT/scripts/lib/main-push-guard.sh" ]; then
  # shellcheck disable=SC1091
  source "$ROOT/scripts/lib/main-push-guard.sh"
  main_sha="$(printf '%s' "$MAIN_PUSH_SHAS" | tail -n1)"

  if ! mpg_acquire_lock "$main_sha" "$REMOTE_NAME" "$REMOTE_URL"; then
    exit 1
  fi
  mpg_install_release_trap   # releases on every exit path from here on

  if ! mpg_check_authorization "$main_sha"; then
    {
      echo ""
      echo "✗ Push to main REFUSED: no valid authorization for $main_sha."
      echo "  This is intentional — pushes to origin/main require an explicit,"
      echo "  single-use authorization bound to this exact commit. Once David"
      echo "  has given the go-ahead for THIS integration, run:"
      echo "    scripts/main-push-lock.sh authorize $main_sha \"<reason — cite the approval>\""
      echo "  Then re-run this push (authorization expires in 30 min, single-use)."
      echo "  Emergency bypass: git push --no-verify — disclose it if you do."
    } >&2
    exit 1
  fi
  MAIN_PUSH_AUTHORIZED_SHA="$main_sha"
fi

# ── 1 · web typecheck (scoped to pushes that touch web-v2, 2026-09-11) ──────
if touches_web; then
  if ! bash "$ROOT/scripts/check-web-build.sh"; then
    exit 1
  fi
fi

# ── 2 · watch gate ───────────────────────────────────────────────────────────
if touches_watch; then
  args=()
  [ "${FAFF_WATCH_FAST:-0}" = "1" ] && args+=(--fast)
  if ! bash "$ROOT/scripts/check-watch.sh" "${args[@]+"${args[@]}"}"; then
    echo ""
    echo "✗ Watch gate FAILED. Push aborted."
    echo "  Fix the above, or override with: git push --no-verify"
    echo "  Standard: docs/design/watch-0821/FACE-QC.md"
    exit 1
  fi
fi

# Consume the authorization only now — right before the hook hands control
# back to git for the actual push. A build or watch-gate failure above exits
# non-zero WITHOUT reaching this line, so the authorization survives for a
# retry of the same commit. Only a full, successful pass burns it, which is
# what prevents it being replayed for a later, different push.
if [ -n "${MAIN_PUSH_AUTHORIZED_SHA:-}" ]; then
  mpg_consume_authorization "$MAIN_PUSH_AUTHORIZED_SHA" || true
fi

exit 0
