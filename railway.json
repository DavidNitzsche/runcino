{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd web-v2 && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "cd web-v2 && npx next start -p $PORT -H 0.0.0.0",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/api/up",
    "healthcheckTimeout": 30,
    "overlapSeconds": 20
  }
}
